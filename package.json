{
    "name": "datatables.net-searchpanes-se",
    "description": "SearchPanes for DataTables with styling for [SemanticUI](https://semantic-ui.com/)",
    "main": "./js/searchPanes.semanticui.js",
    "module": "./js/searchPanes.semanticui.mjs",
    "style": "./css/searchPanes.semanticui.css",
    "types": "./types/searchPanes.semanticui.d.ts",
    "version": "2.3.5",
    "files": [
        "js",
        "css",
        "types"
    ],
    "keywords": [
        "SearchPanes",
        "search",
        "filtering",
        "Semantic",
        "SemanticUI",
        "Semantic UI",
        "Datatables",
        "jQuery",
        "table",
        "filter",
        "sort"
    ],
    "dependencies": {
        "datatables.net-searchpanes": "2.3.5",
        "datatables.net-se": "^2",
        "jquery": ">=1.7"
    },
    "moduleType": [
        "globals",
        "amd",
        "node"
    ],
    "ignore": [
        "composer.json",
        "datatables.json",
        "package.json"
    ],
    "author": {
        "name": "SpryMedia Ltd",
        "url": "http://datatables.net"
    },
    "homepage": "https://datatables.net",
    "bugs": "https://datatables.net/forums",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/DataTables/Dist-DataTables-SearchPanes-SemanticUI.git"
    },
    "exports": {
        ".": {
            "types": "./types/searchPanes.semanticui.d.ts",
            "style": "./css/searchPanes.semanticui.css",
            "import": "./js/searchPanes.semanticui.mjs",
            "require": "./js/searchPanes.semanticui.js",
            "default": "./js/searchPanes.semanticui.mjs"
        },
        "./js/*": "./js/*",
        "./css": {
            "types": "./types/css.d.ts",
            "default": "./css/searchPanes.semanticui.css"
        },
        "./css/*": {
            "types": "./types/css.d.ts",
            "default": "./css/*"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": true
}