<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <metadata>
        <version>3.0.0</version>
        <id>datatables.net-searchpanes-se</id>
        <description>This is SearchPanes for DataTables with styling for [SemanticUI](https://semantic-ui.com/)</description>
        <authors>SpryMedia Ltd</authors>
        <projectUrl>http://datatables.net</projectUrl>
        <license type="file">License.txt</license>
        <tags>SearchPanes  search  filtering  Semantic  SemanticUI  Semantic UI  Datatables table</tags>
        <dependencies>
            <dependency id="datatables.net-searchpanes" version="3.0.0"/>
            <dependency id="datatables.net-se" version="[3.1.0, 4.0.0)"/>
        </dependencies>
        <contentFiles>
            <files include="**/*" buildAction="Content"/>
        </contentFiles>
        <readme>Readme.md</readme>
    </metadata>
    <files>
        <file src="Readme.md" target=""/>
        <file src="js/searchPanes.semanticui.js" target="content\Scripts"/>
        <file src="js/searchPanes.semanticui.js" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/searchPanes.semanticui.min.js" target="content\Scripts"/>
        <file src="js/searchPanes.semanticui.min.js" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/searchPanes.semanticui.min.mjs" target="content\Scripts"/>
        <file src="js/searchPanes.semanticui.min.mjs" target="contentFiles\any\any\wwwroot\js"/>
        <file src="js/searchPanes.semanticui.mjs" target="content\Scripts"/>
        <file src="js/searchPanes.semanticui.mjs" target="contentFiles\any\any\wwwroot\js"/>
        <file src="css/searchPanes.semanticui.css" target="content\Content"/>
        <file src="css/searchPanes.semanticui.css" target="contentFiles\any\any\wwwroot\css"/>
        <file src="css/searchPanes.semanticui.min.css" target="content\Content"/>
        <file src="css/searchPanes.semanticui.min.css" target="contentFiles\any\any\wwwroot\css"/>
    </files>
</package>
